// Cloudflare Worker behind https://rubo6.dev/api/contact (ADR-0012). Deploy: `npm run worker:deploy`.
// Secrets (never in this file): `npx wrangler secret put POW_SECRET` and `npx wrangler secret put RESEND_API_KEY`
// from the repo root (the scripts pass `--config worker/wrangler.jsonc`). Local: `worker/.dev.vars`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rubo6-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rubo6.dev/api/contact*", "zone_name": "rubo6.dev" }],
  "vars": {
    "MAIL_TO": "eruben.bernal@gmail.com",
    // Resend's shared sender delivers only to the account owner's address, which is MAIL_TO. Once the
    // domain is verified in Resend, change to "Observatorio rubo6.dev <senal@rubo6.dev>" (docs/OWNER.md).
    "MAIL_FROM": "Observatorio rubo6.dev <onboarding@resend.dev>",
    "ALLOWED_ORIGINS": "https://rubo6.dev",
    "POW_BITS": "17",
  },
  // Per-visitor limit for the submit endpoint: 3 messages per minute per IP (free plan; 60 s period).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
