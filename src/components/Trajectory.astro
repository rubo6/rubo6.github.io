---
import { useTranslations, type Locale } from '@/i18n/ui';
import { formatMonth, type TrajectoryEntry } from '@/lib/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  entries: TrajectoryEntry[];
}
const { locale, entries } = Astro.props;
const t = useTranslations(locale);

const orbits = Math.max(...entries.map((e) => e.orbit)) + 1;
const size = 520;
const c = size / 2;
const step = (c - 40) / orbits;
---

<section id="trajectory" class="trajectory container-content" aria-labelledby="trajectory-title">
  <SectionHeading
    id="trajectory-title"
    kicker="02"
    title={t('trajectory.title')}
    lead={t('trajectory.lead')}
  />

  <div class="grid">
    <figure class="orbits reveal" aria-hidden="true">
      <svg viewBox={`0 0 ${size} ${size}`} width="100%" height="100%">
        <defs>
          <radialGradient id="sun">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="1"></stop>
            <stop offset="0.6" stop-color="var(--accent)" stop-opacity="0.35"></stop>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle cx={c} cy={c} r="34" fill="url(#sun)"></circle>
        <circle cx={c} cy={c} r="9" fill="var(--accent)"></circle>
        {
          entries.map((e) => {
            const r = 40 + step * (e.orbit + 1) - step * 0.35;
            const dur = 40 + e.orbit * 22;
            const angle = (e.orbit * 67) % 360;
            return (
              <g>
                <circle
                  cx={c}
                  cy={c}
                  r={r}
                  fill="none"
                  stroke="var(--line)"
                  stroke-width="1"
                  stroke-dasharray={e.kind === 'education' ? '3 6' : undefined}
                />
                <g
                  class="planet"
                  style={`--dur:${dur}s;--a:${angle}deg;transform-origin:${c}px ${c}px`}
                >
                  <circle
                    cx={c + r}
                    cy={c}
                    r={e.kind === 'work' ? 7 : 5}
                    fill={
                      e.kind === 'work'
                        ? 'var(--accent)'
                        : e.kind === 'leadership'
                          ? 'var(--accent-2)'
                          : 'var(--accent-3)'
                    }
                  />
                </g>
              </g>
            );
          })
        }
      </svg>
    </figure>

    <ol class="entries">
      {
        entries.map((e, i) => (
          <li class:list={['entry reveal', `kind-${e.kind}`]} data-delay={String((i % 4) + 1)}>
            <div class="marker" aria-hidden="true" />
            <div class="entry-body">
              <p class="mono meta">
                <span class="kind">{t(`trajectory.kind.${e.kind}` as 'trajectory.kind.work')}</span>
                <span>
                  {formatMonth(e.start, locale, '')} →{' '}
                  {formatMonth(e.end, locale, t('trajectory.present'))}
                </span>
                <span>{e.location}</span>
              </p>
              <h3 class="text-xl">{e.role}</h3>
              <p class="org">
                {e.orgUrl ? (
                  <a href={e.orgUrl} rel="noopener noreferrer" target="_blank">
                    {e.org} ↗
                  </a>
                ) : (
                  e.org
                )}
              </p>
              {e.summary && <p class="text-ink-muted mt-2">{e.summary}</p>}
              <ul class="bullets">
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {e.stack.length > 0 && (
                <ul class="chips" aria-label={t('observatory.stack')}>
                  {e.stack.map((s) => (
                    <li translate="no">{s}</li>
                  ))}
                </ul>
              )}
              {e.sources.length > 0 && (
                <p class="sources">
                  <span>{t('trajectory.sources')}:</span>
                  {e.sources.map((src) => (
                    <a href={src.url} rel="noopener noreferrer" target="_blank">
                      {src.label} ↗
                    </a>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .trajectory {
    padding-block: 5rem;
    scroll-margin-top: var(--nav-h);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  .orbits {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    margin: 0;
    aspect-ratio: 1;
  }
  .planet {
    animation: orbit var(--dur) linear infinite;
    transform: rotate(var(--a));
  }
  @keyframes orbit {
    from {
      transform: rotate(var(--a));
    }
    to {
      transform: rotate(calc(var(--a) + 360deg));
    }
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .entries::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--line);
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
  }
  .marker {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    margin-top: 0.35rem;
    background: var(--bg-0);
    border: 2px solid var(--accent);
    box-shadow: 0 0 10px color-mix(in oklab, var(--accent) 60%, transparent);
  }
  .kind-leadership .marker {
    border-color: var(--accent-2);
    box-shadow: 0 0 10px color-mix(in oklab, var(--accent-2) 60%, transparent);
  }
  .kind-education .marker {
    border-color: var(--accent-3);
    box-shadow: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .kind {
    color: var(--accent);
  }
  .kind-leadership .kind {
    color: var(--accent-2);
  }
  .kind-education .kind {
    color: var(--accent-3);
  }
  h3 {
    margin-top: 0.5rem;
  }
  .org {
    margin-top: 0.2rem;
    color: var(--ink-muted);
  }
  .org a {
    text-decoration: none;
  }
  .bullets {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .bullets li::marker {
    color: var(--accent);
  }
  .sources {
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .sources a {
    color: var(--ink-muted);
    text-decoration-color: color-mix(in oklch, var(--accent) 50%, transparent);
  }
  .sources a:hover {
    color: var(--accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .chips li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    color: var(--ink-muted);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .orbits {
      position: static;
      max-width: 20rem;
      margin: 0 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .planet {
      animation: none;
    }
  }
</style>
