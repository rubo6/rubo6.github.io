---
/**
 * Full-bleed official telescope image behind a page or section header, veiled so text stays
 * readable, with a small credit line (licence requires attribution).
 * Sources and credits: src/assets/scenes/credits.json (generated by scripts/optimize-scenes.mjs).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Locale } from '@/i18n/ui';
import credits from '@/assets/scenes/credits.json';

type SceneId = 'crab' | 'cartwheel' | 'tarantula' | 'wr124' | 'stephans-quintet';

interface Props {
  id: SceneId;
  locale: Locale;
  /** 'header' = tall veil for page heads; 'section' = subtler wash behind a home section. */
  variant?: 'header' | 'section';
  /** Show the credit line (default true). */
  credit?: boolean;
}
const { id, locale, variant = 'header', credit: showCredit = true } = Astro.props;
const t = useTranslations(locale);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/scenes/*.avif', {
  eager: true,
});
const image = images[`/src/assets/scenes/${id}.avif`]?.default;
const meta = credits.find((c) => c.id === id);
---

{
  image && meta && (
    <div class:list={['scene', `scene-${variant}`]} aria-hidden="true">
      <Picture
        src={image}
        formats={['avif', 'webp']}
        widths={[800, 1600]}
        sizes="100vw"
        alt=""
        class="scene-img"
        loading={variant === 'header' ? 'eager' : 'lazy'}
        fetchpriority={variant === 'header' ? 'low' : 'auto'}
        decoding="async"
      />
      <div class="scene-veil" />
      {showCredit && (
        <p class="scene-credit mono">
          <a href={meta.source} rel="noopener noreferrer" target="_blank" tabindex="-1">
            {meta.object} · {meta.telescope} · {t('observatory.imageCredit')}: {meta.credit}
          </a>
        </p>
      )}
    </div>
  )
}

<style>
  .scene {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .scene-img,
  .scene-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: scene-breathe 28s ease-in-out infinite alternate;
  }
  .scene-header .scene-img :global(img) {
    opacity: 0.7;
  }
  .scene-section .scene-img :global(img) {
    opacity: 0.28;
  }
  :global([data-theme='atlas']) .scene-img :global(img) {
    opacity: 0.22;
    filter: saturate(0.8);
  }
  .scene-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--bg-0) 55%, transparent), transparent 35%),
      linear-gradient(
        0deg,
        var(--bg-0) 4%,
        color-mix(in oklab, var(--bg-0) 55%, transparent) 45%,
        transparent 90%
      ),
      radial-gradient(
        80% 70% at 50% 40%,
        transparent,
        color-mix(in oklab, var(--bg-0) 60%, transparent)
      );
  }
  /* Paper theme: the photo is darker than the page, so add a light wash for text contrast. */
  :global([data-theme='atlas']) .scene-veil {
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--bg-0) 70%, transparent), transparent 40%),
      linear-gradient(
        0deg,
        var(--bg-0) 6%,
        color-mix(in oklab, var(--bg-0) 70%, transparent) 50%,
        transparent 95%
      ),
      color-mix(in oklab, var(--bg-0) 35%, transparent);
  }
  .scene-credit {
    position: absolute;
    right: 1.1rem;
    bottom: 0.75rem;
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--ink-muted) 75%, transparent);
    pointer-events: auto;
    max-width: 70%;
    text-align: right;
  }
  .scene-credit a {
    text-decoration: none;
    color: inherit;
  }
  .scene-credit a:hover {
    color: var(--accent);
  }
  @keyframes scene-breathe {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.1) translate3d(-1%, -1%, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-img :global(img) {
      animation: none;
    }
  }
</style>
