---
/**
 * Skills as constellations. Node positions are deterministic (hash of the skill name),
 * lines connect each star to its nearest already-placed neighbour, so the figure is stable
 * across builds and needs no JavaScript.
 */
import { useTranslations, type Locale } from '@/i18n/ui';
import { pick, type Certification, type Profile, type SkillGroup } from '@/lib/content';
import { unitHash } from '@/scripts/sky';
import SectionHeading from './SectionHeading.astro';
import SceneBackdrop from './SceneBackdrop.astro';

interface Props {
  locale: Locale;
  groups: SkillGroup[];
  certifications: Certification[];
  softSkills: Profile['softSkills'];
}
const { locale, groups, certifications, softSkills } = Astro.props;
const t = useTranslations(locale);

const W = 360;
const PAD_X = 54;
const ROW_H = 92;

function layout(group: SkillGroup) {
  const nodes = group.items.map((item, i) => {
    // Spread on a loose grid then jitter deterministically so labels rarely collide.
    const cols = 3;
    const rows = Math.ceil(group.items.length / cols);
    const H = 60 + rows * ROW_H;
    const col = i % cols;
    const row = Math.floor(i / cols);
    const jx = (unitHash(`${group.id}:${item.name}:x`) - 0.5) * 12;
    const jy = (unitHash(`${group.id}:${item.name}:y`) - 0.5) * 12;
    const x = PAD_X + col * ((W - PAD_X * 2) / Math.max(1, cols - 1)) + jx;
    const y = 46 + row * ROW_H + jy;
    const cx = Math.min(W - PAD_X, Math.max(PAD_X, x));
    const anchor: 'start' | 'middle' | 'end' =
      cx < W * 0.28 ? 'start' : cx > W * 0.72 ? 'end' : 'middle';
    const labelDx = anchor === 'start' ? -6 : anchor === 'end' ? 6 : 0;
    // Checkerboard: neighbours in the same row and column put labels on opposite sides.
    const labelBelow = (row + col) % 2 === 0;
    return { ...item, x: cx, y: Math.min(H - 30, Math.max(30, y)), anchor, labelDx, labelBelow, H };
  });
  const lines: [number, number][] = [];
  for (let i = 1; i < nodes.length; i++) {
    let best = 0;
    let bestD = Infinity;
    for (let j = 0; j < i; j++) {
      const d = (nodes[i]!.x - nodes[j]!.x) ** 2 + (nodes[i]!.y - nodes[j]!.y) ** 2;
      if (d < bestD) {
        bestD = d;
        best = j;
      }
    }
    lines.push([i, best]);
  }
  const height = nodes[0]?.H ?? 200;
  return { nodes, lines, height };
}
const radius = (level: number) => [0, 2.2, 3, 3.9, 5][level] ?? 3;
---

<section
  id="constellation"
  class="constellation container-content"
  aria-labelledby="constellation-title"
>
  <SceneBackdrop id="ngc604" locale={locale} variant="section" />
  <SectionHeading
    id="constellation-title"
    kicker="03"
    title={t('constellation.title')}
    lead={t('constellation.lead')}
  />
  <p class="hint mono text-xs text-ink-muted">{t('constellation.hint')}</p>

  <div class="groups">
    {
      groups.map((g, gi) => {
        const { nodes, lines, height } = layout(g);
        return (
          <article class="group glow lift reveal" data-delay={String((gi % 4) + 1)}>
            <header>
              <h3 class="text-lg">{pick(g.labels, locale)}</h3>
              <p class="mono text-xs text-ink-muted">{g.constellation}</p>
            </header>
            <svg viewBox={`0 0 ${W} ${height}`} role="list" aria-label={pick(g.labels, locale)}>
              <g stroke="var(--accent-3)" stroke-width="0.7" opacity="0.5">
                {lines.map(([a, b]) => (
                  <line x1={nodes[a]!.x} y1={nodes[a]!.y} x2={nodes[b]!.x} y2={nodes[b]!.y} />
                ))}
              </g>
              {nodes.map((n) => (
                <g
                  role="listitem"
                  class="star"
                  tabindex="0"
                  aria-label={`${n.name}: ${t(`constellation.level.${n.level}` as 'constellation.level.1')}${n.via ? ` · ${n.via}` : ''}`}
                >
                  {n.via && <title>{`${n.name} — ${n.via}`}</title>}
                  <circle
                    cx={n.x}
                    cy={n.y}
                    r={radius(n.level) * 2.4}
                    fill="var(--accent)"
                    opacity="0.12"
                  />
                  <circle
                    cx={n.x}
                    cy={n.y}
                    r={radius(n.level)}
                    fill={n.level >= 4 ? 'var(--accent)' : 'var(--ink)'}
                  />
                  <text
                    x={n.x + n.labelDx}
                    y={n.labelBelow ? n.y + radius(n.level) + 12 : n.y - radius(n.level) - 6}
                    text-anchor={n.anchor}
                    font-size="9"
                    fill="var(--ink)"
                    font-family="var(--font-mono)"
                  >
                    {n.name}
                  </text>
                </g>
              ))}
            </svg>
            <ul class="legend mono" aria-hidden="true">
              <li>
                <i style="--r:5px" /> {t('constellation.level.4')}
              </li>
              <li>
                <i style="--r:3.9px" /> {t('constellation.level.3')}
              </li>
              <li>
                <i style="--r:3px" /> {t('constellation.level.2')}
              </li>
              <li>
                <i style="--r:2.2px" /> {t('constellation.level.1')}
              </li>
            </ul>
          </article>
        );
      })
    }
  </div>

  <div class="boxes">
    {
      softSkills.length > 0 && (
        <div class="soft reveal glow lift" data-delay="1">
          <h3 class="text-lg">{t('constellation.soft')}</h3>
          <ul class="soft-list">
            {softSkills.map((s) => (
              <li>
                <strong>{s.name}</strong>
                <span class="text-ink-muted">{s.evidence}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="certs reveal" data-delay="2">
      <h3 class="text-lg">{t('certs.title')}</h3>
      <ul class="cert-list">
        {
          certifications.map((c) => (
            <li class={`cert status-${c.status}`}>
              <span class="cert-status mono">
                {t(`certs.status.${c.status}` as 'certs.status.earned')}
              </span>
              <span class="cert-name">
                {c.url ? (
                  <a href={c.url} rel="noopener noreferrer" target="_blank">
                    {c.name} ↗
                  </a>
                ) : (
                  c.name
                )}
              </span>
              <span class="cert-issuer text-ink-muted">
                {c.issuer}
                {c.date ? ` · ${c.date.slice(0, 7)}` : ''}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hint {
    margin-top: 0.75rem;
  }
  .star circle {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform var(--dur-base) var(--ease-spring),
      opacity var(--dur-base) var(--ease-out);
  }
  .star:hover circle:first-of-type,
  .star:focus-visible circle:first-of-type {
    transform: scale(1.9);
    opacity: 0.35;
  }
  .star:hover circle:last-of-type,
  .star:focus-visible circle:last-of-type {
    transform: scale(1.35);
  }
  .star:hover text,
  .star:focus-visible text {
    fill: var(--accent);
    transform: scale(1.8);
    paint-order: stroke fill;
    stroke: var(--bg-1);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .star text {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }
  .star {
    cursor: help;
    outline: none;
  }

  .constellation {
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    padding-block: 5rem;
    scroll-margin-top: var(--nav-h);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .group {
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(
      in oklab,
      var(--bg-1) 88%,
      transparent
    ); /* opaque enough to stay legible over the photo backdrop */
    contain: layout style paint;
  }
  .group header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  svg {
    width: 100%;
    height: auto;
    margin-top: 0.75rem;
  }
  .legend {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.68rem;
    color: var(--ink-muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .legend i {
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    border-radius: 50%;
    background: var(--ink);
  }
  .boxes {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .boxes {
      grid-template-columns: 1fr;
    }
  }
  /* Soft skills live here, next to the hard skills, because each one is backed by a work or study
     fact. They are professional content: hidden while the personal universe is active (Rubo's call). */
  :global([data-mode='personal']) .soft {
    display: none;
  }
  :global([data-mode='personal']) .boxes {
    grid-template-columns: 1fr;
  }
  .soft {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--bg-1) 60%, transparent);
  }
  .soft-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .soft-list li {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-sm);
  }
  .certs {
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
  }
  .cert-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }
  .cert {
    display: grid;
    gap: 0.2rem;
    font-size: var(--text-sm);
  }
  .cert-status {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-3);
  }
  .status-earned .cert-status {
    color: var(--accent);
  }
  .status-expected .cert-status {
    color: var(--accent-2);
  }
  .cert-name {
    font-weight: 500;
  }
</style>

<script>
  import { onReady } from '@/scripts/lifecycle';
  // SVG paints in document order: move the hovered/focused star to the end of its group so the
  // magnified label is drawn above its neighbours.
  function bind() {
    document.querySelectorAll<SVGGElement>('.star:not([data-bound])').forEach((star) => {
      star.dataset.bound = '1';
      const raise = () => star.parentNode?.appendChild(star);
      star.addEventListener('pointerenter', raise);
      star.addEventListener('focus', raise);
    });
  }
  onReady(bind);
</script>
