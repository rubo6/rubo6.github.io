---
interface Props {
  id?: string;
  kicker?: string;
  title: string;
  lead?: string;
  /** Alternate lead shown in personal mode (swapped by CSS, both are in the DOM). */
  leadPersonal?: string;
  align?: 'left' | 'center';
}
const { id, kicker, title, lead, leadPersonal, align = 'left' } = Astro.props;
---

<header
  class:list={['section-heading reveal', align === 'center' && 'text-center mx-auto']}
  data-delay="0"
>
  {
    kicker && (
      <p class="kicker mono text-accent-3 text-xs tracking-[0.22em] uppercase">
        <svg
          class="reticle spin-slow"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="3 4"
          />
          <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1" />
          <path d="M12 0v4M12 20v4M0 12h4M20 12h4" stroke="currentColor" stroke-width="1" />
        </svg>
        {kicker}
      </p>
    )
  }
  <h2 id={id} class="mt-3">{title}</h2>
  {
    lead && (
      <p class:list={['lead text-ink-muted mt-5 max-w-2xl text-lg', leadPersonal && 'lead-pro']}>
        {lead}
      </p>
    )
  }
  {
    leadPersonal && (
      <p class="lead lead-personal text-ink-muted mt-5 max-w-2xl text-lg">{leadPersonal}</p>
    )
  }
</header>

<style>
  .section-heading {
    max-width: 60rem;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .reticle {
    flex: none;
    opacity: 0.85;
  }
  .lead-personal {
    display: none;
  }
  :global([data-mode='personal']) .lead-pro {
    display: none;
  }
  :global([data-mode='personal']) .lead-personal {
    display: block;
  }
</style>
