---
import { localePath, useTranslations, type Locale } from '@/i18n/ui';
import type { Profile } from '@/lib/content';
import { safeJson } from '@/lib/json';
import catalog from '@/data/bright-stars.json';
import LiveCounters from './LiveCounters.astro';

interface Props {
  locale: Locale;
  profile: Profile;
}
const { locale, profile } = Astro.props;
const t = useTranslations(locale);
const skyData = {
  lat: profile.location.lat,
  lon: profile.location.lon,
  catalog: { stars: catalog.stars, constellations: catalog.constellations },
};
---

<section id="sky" class="hero" aria-labelledby="hero-title">
  <div class="sky-wrap" aria-hidden="false">
    <canvas class="sky" data-sky role="img" aria-label={t('hero.sky.aria')}></canvas>
    <div class="sky-veil" aria-hidden="true"></div>
  </div>

  <div class="container-content hero-grid">
    <div class="hero-copy">
      <p class="kicker mono reveal" data-delay="0">{t('hero.kicker')}</p>
      <h1 id="hero-title" class="reveal" data-delay="1">
        <span class="name-pro">{profile.name}</span>
        <span class="name-personal" aria-hidden="true">{profile.nickname}</span>
      </h1>
      <p class="headline reveal" data-delay="2">{profile.headline}</p>
      <p class="tagline tagline-pro reveal text-ink-muted" data-delay="3">{profile.tagline}</p>
      <p class="tagline tagline-personal reveal text-ink-muted" data-delay="3">
        {profile.personalIntro}
      </p>
      <div class="actions reveal" data-delay="4">
        <a class="btn btn-primary" href="#observatory">{t('hero.cta.observatory')}</a>
        <a class="btn btn-ghost" href={localePath(locale, '/cv')}>{t('hero.cta.cv')}</a>
      </div>
    </div>

    <aside class="sky-meta reveal" data-delay="4" aria-label={t('hero.sky.caption')}>
      <p class="mono text-xs uppercase tracking-[0.2em] text-accent-3">{t('hero.sky.caption')}</p>
      <p class="mono lst">
        <span class="text-ink-muted">{t('hero.sky.lst')}</span>
        <span class="lst-value" data-sky-clock>--h --m --s</span>
      </p>
      <p class="mono text-xs text-ink-muted coords">
        {profile.location.lat.toFixed(4)}° N · {Math.abs(profile.location.lon).toFixed(4)}° W
      </p>
    </aside>
  </div>

  <div class="container-content">
    <LiveCounters locale={locale} profile={profile} />
  </div>

  <script type="application/json" id="sky-data" set:html={safeJson(skyData)} />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 10vh, 8rem) 4rem;
    min-height: calc(100dvh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .sky-wrap {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .sky {
    width: 100%;
    height: 100%;
  }
  .sky-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--bg-0) 78%, transparent) 0%,
        transparent 60%
      ),
      linear-gradient(to top, var(--bg-0) 0%, transparent 35%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.7fr);
    gap: 3rem;
    align-items: end;
  }
  .kicker {
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-3);
  }
  h1 {
    margin-top: 1rem;
    max-width: 14ch;
  }
  .name-personal,
  .tagline-personal {
    display: none;
  }
  :global([data-mode='personal']) .name-pro,
  :global([data-mode='personal']) .tagline-pro {
    display: none;
  }
  :global([data-mode='personal']) .name-personal,
  :global([data-mode='personal']) .tagline-personal {
    display: block;
  }
  .headline {
    margin-top: 1.4rem;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--accent);
    text-wrap: balance;
  }
  .tagline {
    margin-top: 1rem;
    font-size: var(--text-lg);
    max-width: 52ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }
  .sky-meta {
    justify-self: end;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--bg-1) 55%, transparent);
    backdrop-filter: blur(10px);
    min-width: 16rem;
  }
  .lst {
    display: flex;
    flex-direction: column;
    margin-top: 0.6rem;
    font-size: var(--text-sm);
  }
  .lst-value {
    font-size: var(--text-xl);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .coords {
    margin-top: 0.4rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sky-meta {
      justify-self: start;
    }
    .sky-veil {
      background: linear-gradient(
        to top,
        var(--bg-0) 0%,
        color-mix(in oklab, var(--bg-0) 55%, transparent) 60%,
        transparent 100%
      );
    }
  }
</style>

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius-pill);
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
    touch-action: manipulation;
    user-select: none;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg-0);
  }
  .btn-primary:hover {
    background: color-mix(in oklab, var(--accent) 85%, white);
    color: var(--bg-0);
  }
  .btn-ghost {
    border-color: var(--line);
    color: var(--ink);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

<script>
  import { mountSky, readJson } from '@/scripts/sky';

  let dispose: (() => void) | null = null;
  function boot() {
    dispose?.();
    const canvas = document.querySelector<HTMLCanvasElement>('[data-sky]');
    const data = readJson<{ lat: number; lon: number; catalog: never }>('sky-data');
    if (!canvas || !data) return;
    dispose = mountSky({
      canvas,
      catalog: data.catalog,
      lat: data.lat,
      lon: data.lon,
      clock: document.querySelector<HTMLElement>('[data-sky-clock]'),
    });
  }
  boot();
  document.addEventListener('astro:after-swap', boot);
</script>
