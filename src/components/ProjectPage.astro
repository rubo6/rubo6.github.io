---
import Base from '@/layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { localePath, useTranslations, type Locale } from '@/i18n/ui';
import {
  formatCount,
  formatMonth,
  getRepoStats,
  pick,
  type Nebula,
  type Project,
} from '@/lib/content';
import { render } from 'astro:content';

interface Props {
  locale: Locale;
  project: Project;
  nebula: Nebula;
}
const { locale, project, nebula } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(project);
const stats = project.data.repo ? (await getRepoStats()).get(project.data.repo) : undefined;
const path = `/projects/${project.data.key}`;
---

<Base locale={locale} path={path} title={project.data.title} description={project.data.summary}>
  <Nav locale={locale} path={path} minimal />
  <main id="main" class="container-content project">
    <a class="back mono text-sm" href={`${localePath(locale, '/')}#observatory:${nebula.id}`}
      >← {t('project.back')}</a
    >

    <header class="head">
      <p class="mono text-accent-3 text-xs uppercase tracking-[0.2em]">
        {t('project.nebula')}: {pick(nebula.labels, locale)} · {nebula.object.name} · {
          nebula.object.designation
        }
      </p>
      <h1 class="mt-3">{project.data.title}</h1>
      <p class="text-ink-muted mt-5 max-w-3xl text-lg">{project.data.summary}</p>
      <dl class="facts mono">
        <div><dt>{t('observatory.role')}</dt><dd>{project.data.role}</dd></div>
        <div>
          <dt>{t('observatory.period')}</dt>
          <dd>
            {formatMonth(project.data.period.start, locale, '')} → {
              formatMonth(project.data.period.end, locale, t('observatory.present'))
            }
          </dd>
        </div>
        <div>
          <dt>{t('observatory.stack')}</dt>
          <dd>{project.data.stack.join(' · ')}</dd>
        </div>
        {
          project.data.visibility === 'public' && project.data.repo && (
            <div>
              <dt>{t('observatory.repo')}</dt>
              <dd>
                <a
                  href={`https://github.com/${project.data.repo}`}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {project.data.repo} ↗
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      {
        project.data.visibility === 'public' && stats && (
          <p class="mono text-xs text-ink-muted mt-4">
            ★ {formatCount(stats.stars, locale)} {t('repo.stars')} · ⑂{' '}
            {formatCount(stats.forks, locale)} {t('repo.forks')}
            {stats.traffic &&
              ` · ◉ ${formatCount(stats.traffic.views, locale)} ${t('repo.views')} · ${formatCount(stats.traffic.clones, locale)} ${t('repo.clones')}`}
            {stats.language && ` · ${stats.language}`} · {t('repo.updated')}{' '}
            {formatMonth(stats.pushedAt.slice(0, 10), locale, '')}
          </p>
        )
      }
      {
        project.data.visibility !== 'public' && (
          <p class="mono text-xs text-ink-muted mt-4">
            {t(
              project.data.visibility === 'course'
                ? 'observatory.course'
                : 'observatory.confidential',
            )}
          </p>
        )
      }
    </header>

    <section class="body">
      <div class="prose">
        <Content />
      </div>
      <aside class="side">
        <h2 class="text-lg">{t('observatory.highlights')}</h2>
        <ul class="highlights">
          {
            project.data.highlights.map((h) => (
              <li>
                <span class="hstar" aria-hidden="true" />
                {h}
              </li>
            ))
          }
        </ul>
        {
          project.data.links.length > 0 && (
            <ul class="links">
              {project.data.links.map((l) => (
                <li>
                  <a href={l.url} rel="noopener noreferrer" target="_blank">
                    {l.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .project {
    padding-block: 3rem 5rem;
  }
  .back {
    text-decoration: none;
    color: var(--ink-muted);
  }
  .head {
    margin-top: 2rem;
    max-width: 60rem;
  }
  h1 {
    font-size: var(--text-3xl);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
  }
  .facts div {
    display: grid;
    gap: 0.3rem;
  }
  .facts dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }
  .facts dd {
    margin: 0;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }
  .prose {
    font-size: var(--text-lg);
    line-height: 1.7;
    max-width: 65ch;
  }
  .prose :global(p + p) {
    margin-top: 1.2em;
  }
  .side {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--bg-1) 60%, transparent);
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }
  .highlights {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .highlights li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }
  .hstar {
    margin-top: 0.45em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in oklab, var(--accent) 70%, transparent);
    justify-self: center;
  }
  .links {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.4rem;
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
  }
</style>
