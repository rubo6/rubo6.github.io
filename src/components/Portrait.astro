---
/**
 * The "eyepiece": a portrait frame in the hero with up to three media.
 *  - Illustration: three generated portraits that follow the universe —
 *      night + professional → editorial, night + personal → constellation, atlas theme → engraving.
 *  - Video: optional short loop (public/media/portrait.mp4 + .webm). Rendered only when the file exists.
 *      Muted, no autoplay, plays on user request, honours prefers-reduced-motion.
 *  - Photo: optional real photograph (src/assets/generated/photo.avif/.webp). Rendered only when present.
 * Tabs are real buttons with aria-pressed; the active medium is announced via the frame's aria-label.
 */
import { existsSync } from 'node:fs';
import path from 'node:path';
import { Picture } from 'astro:assets';
import editorial from '@/assets/generated/avatar-editorial.avif';
import constellation from '@/assets/generated/avatar-constellation.avif';
import atlas from '@/assets/generated/avatar-atlas.avif';
import { useTranslations, type Locale } from '@/i18n/ui';
import type { ImageMetadata } from 'astro';

interface Props {
  locale: Locale;
  name: string;
}
const { locale, name } = Astro.props;
const t = useTranslations(locale);

const hasVideo = existsSync(path.resolve('public/media/portrait.mp4'));
const hasWebm = existsSync(path.resolve('public/media/portrait.webm'));
/** Optional real photograph: drop photo.avif/.webp/.jpg/.png into src/assets/generated to enable the tab. */
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/generated/photo.{avif,webp,jpg,png}',
  { eager: true },
);
const photo: ImageMetadata | null = Object.values(photoModules)[0]?.default ?? null;
const media = [
  'illustration',
  ...(hasVideo ? ['video'] : []),
  ...(photo ? ['photo'] : []),
] as const;
---

<figure
  class="portrait"
  data-portrait
  data-active="illustration"
  aria-label={`${name} — ${t('portrait.illustration')}`}
>
  <div class="frame">
    <span class="ring" aria-hidden="true"></span>
    <span class="ring ring-2" aria-hidden="true"></span>

    <div class="medium medium-illustration" data-medium="illustration">
      <Picture
        src={editorial}
        formats={['avif', 'webp']}
        widths={[440, 880]}
        sizes="(max-width: 900px) 60vw, 22rem"
        alt={t('portrait.alt.editorial')}
        class="art art-editorial"
        loading="eager"
        fetchpriority="high"
      />
      <Picture
        src={constellation}
        formats={['avif', 'webp']}
        widths={[440, 880]}
        sizes="(max-width: 900px) 60vw, 22rem"
        alt={t('portrait.alt.constellation')}
        class="art art-constellation"
        loading="lazy"
      />
      <Picture
        src={atlas}
        formats={['avif', 'webp']}
        widths={[440, 880]}
        sizes="(max-width: 900px) 60vw, 22rem"
        alt={t('portrait.alt.atlas')}
        class="art art-atlas"
        loading="lazy"
      />
    </div>

    {
      hasVideo && (
        <div class="medium medium-video" data-medium="video" hidden>
          <video
            class="art"
            playsinline
            muted
            loop
            preload="none"
            poster={editorial.src}
            width="880"
            height="1100"
            aria-label={t('portrait.video')}
          >
            {hasWebm && <source src="/media/portrait.webm" type="video/webm" />}
            <source src="/media/portrait.mp4" type="video/mp4" />
          </video>
          <button type="button" class="play" data-portrait-play aria-label={t('portrait.play')}>
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z" fill="currentColor" />
            </svg>
          </button>
        </div>
      )
    }

    {
      photo && (
        <div class="medium medium-photo" data-medium="photo" hidden>
          <Picture
            src={photo}
            formats={['avif', 'webp']}
            widths={[440, 880]}
            sizes="(max-width: 900px) 60vw, 22rem"
            alt={t('portrait.alt.photo')}
            class="art"
            loading="lazy"
          />
        </div>
      )
    }
  </div>

  {
    media.length > 1 && (
      <div class="tabs" role="group" aria-label={t('portrait.switch')}>
        {media.map((m) => (
          <button
            type="button"
            class="tab"
            data-portrait-tab={m}
            aria-pressed={m === 'illustration' ? 'true' : 'false'}
          >
            {t(`portrait.${m}` as 'portrait.illustration')}
          </button>
        ))}
      </div>
    )
  }
  <figcaption class="mono caption">{t('portrait.caption')}</figcaption>
</figure>

<style>
  .portrait {
    margin: 0;
    display: grid;
    gap: 0.6rem;
    justify-items: center;
    width: min(22rem, 100%);
  }
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 48% 48% 44% 44% / 40% 40% 52% 52%;
    overflow: hidden;
    isolation: isolate;
    background: color-mix(in oklab, var(--bg-1) 70%, transparent);
    box-shadow:
      0 30px 80px -30px rgb(0 0 0 / 0.7),
      inset 0 0 0 1px var(--line);
  }
  .ring {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--accent) 45%, transparent);
    pointer-events: none;
    animation: orbit 60s linear infinite;
    border-style: dashed;
    z-index: 2;
  }
  .ring-2 {
    inset: -14%;
    border-color: color-mix(in oklab, var(--accent-3) 30%, transparent);
    animation-duration: 95s;
    animation-direction: reverse;
    border-style: dotted;
  }
  .medium,
  .medium :global(picture),
  .medium :global(img),
  .medium video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .medium :global(img),
  .medium video {
    object-fit: cover;
    object-position: center top;
  }
  /* Illustration follows theme × mode */
  .art-constellation,
  .art-atlas {
    opacity: 0;
    transition: opacity var(--dur-universe) var(--ease-out);
  }
  .art-editorial {
    opacity: 1;
    transition: opacity var(--dur-universe) var(--ease-out);
  }
  :global([data-mode='personal']) .art-editorial {
    opacity: 0;
  }
  :global([data-mode='personal']) .art-constellation {
    opacity: 1;
  }
  :global([data-theme='atlas']) .art-editorial,
  :global([data-theme='atlas']) .art-constellation {
    opacity: 0;
  }
  :global([data-theme='atlas']) .art-atlas {
    opacity: 1;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--bg-0) 70%, transparent);
    color: var(--accent);
    border: 1px solid var(--accent);
    backdrop-filter: blur(6px);
    z-index: 3;
  }
  .play[data-playing='true'] {
    opacity: 0;
    pointer-events: none;
  }
  .tabs {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--bg-1) 60%, transparent);
  }
  .tab {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    min-height: 2rem;
  }
  .tab[aria-pressed='true'] {
    background: var(--accent);
    color: var(--bg-0);
  }
  .caption {
    font-size: 0.68rem;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }
</style>

<script>
  function mount() {
    document.querySelectorAll<HTMLElement>('[data-portrait]:not([data-bound])').forEach((fig) => {
      fig.dataset.bound = '1';
      const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[data-portrait-tab]')];
      const media = [...fig.querySelectorAll<HTMLElement>('[data-medium]')];
      const video = fig.querySelector<HTMLVideoElement>('video');
      const play = fig.querySelector<HTMLButtonElement>('[data-portrait-play]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const show = (id: string) => {
        fig.dataset.active = id;
        for (const m of media) m.hidden = m.dataset.medium !== id;
        for (const b of tabs) b.setAttribute('aria-pressed', String(b.dataset.portraitTab === id));
        if (video && id !== 'video') {
          video.pause();
          play?.removeAttribute('data-playing');
        }
      };
      tabs.forEach((b) =>
        b.addEventListener('click', () => show(b.dataset.portraitTab ?? 'illustration')),
      );

      if (video && play) {
        const toggle = () => {
          if (video.paused) {
            video
              .play()
              .then(() => play.setAttribute('data-playing', 'true'))
              .catch(() => {});
          } else {
            video.pause();
            play.removeAttribute('data-playing');
          }
        };
        play.addEventListener('click', toggle);
        video.addEventListener('click', toggle);
        video.addEventListener('ended', () => play.removeAttribute('data-playing'));
        if (reduced) video.removeAttribute('loop');
      }
    });
  }
  mount();
  document.addEventListener('astro:after-swap', mount);
</script>
