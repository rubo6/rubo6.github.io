---
/**
 * The immersive centrepiece. Two scenes share the same markup pattern:
 *  - Professional: nebulae = project categories, stars = project highlights.
 *  - Personal: nebulae = interests, stars = items. Soft skills and fun facts sit below.
 * The scenes swap with data-mode; the canvas hero runs the warp, this section fades.
 * Nebulae are rendered procedurally (layered radial gradients, deterministic star dust) so the
 * site works with zero images; an official JWST/Hubble image can be dropped in per nebula later.
 */
import { localePath, useTranslations, type Locale } from '@/i18n/ui';
import {
  formatCount,
  formatMonth,
  getRepoStats,
  pick,
  type Nebula,
  type Personal,
  type Project,
  getContributions,
} from '@/lib/content';
import { unitHash } from '@/scripts/sky';
import SectionHeading from './SectionHeading.astro';
import Contributions from './Contributions.astro';
import { Picture } from 'astro:assets';
import personalBg from '@/assets/generated/personal-bg.avif';
import type { ImageMetadata } from 'astro';
import credits from '@/assets/nebulae/credits.json';

/** Official JWST / Hubble imagery per nebula id (see src/assets/nebulae/credits.json). */
const nebulaImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/nebulae/*.avif', {
  eager: true,
});
function nebulaImage(id: string): ImageMetadata | undefined {
  return nebulaImages[`/src/assets/nebulae/${id}.avif`]?.default;
}
type Credit = {
  id: string;
  telescope: string;
  instrument?: string;
  credit: string;
  license: string;
  source: string;
};
const creditById = new Map((credits as Credit[]).map((c) => [c.id, c]));

interface Props {
  locale: Locale;
  nebulae: Nebula[];
  projects: Project[];
  personal: Personal;
}
const { locale, nebulae, projects, personal } = Astro.props;
const t = useTranslations(locale);

const repoStats = await getRepoStats();
const contributions = await getContributions();
const byNebula = new Map<string, Project[]>();
for (const p of projects) byNebula.set(p.data.nebula, [...(byNebula.get(p.data.nebula) ?? []), p]);

/** Deterministic star dust positions inside a nebula, seeded by text. */
function dust(seed: string, count: number) {
  return Array.from({ length: count }, (_, i) => {
    const a = unitHash(`${seed}:${i}:a`) * Math.PI * 2;
    const r = Math.sqrt(unitHash(`${seed}:${i}:r`)) * 46;
    return {
      x: 50 + Math.cos(a) * r,
      y: 50 + Math.sin(a) * r,
      s: 0.6 + unitHash(`${seed}:${i}:s`) * 1.6,
    };
  });
}

/** Official image behind each personal cluster (ids in src/assets/nebulae/credits.json). */
const personalImage: Record<string, string> = {
  astronomy: 'academic',
  music: 'music',
  gaming: 'gaming',
  water: 'personal',
};

const personalScene = personal.clusters.map((c, i) => ({
  id: c.id,
  label: c.title,
  object: c.object,
  blurb: c.blurb,
  items: c.items,
  // Spread so labels (which hang below each nebula) never collide: two up, two down, alternating.
  scene: [
    { x: 24, y: 34, scale: 1.15 },
    { x: 72, y: 28, scale: 1 },
    { x: 40, y: 72, scale: 0.95 },
    { x: 82, y: 70, scale: 0.85 },
    { x: 58, y: 48, scale: 0.8 },
  ][i % 5]!,
  image: personalImage[c.id],
  palette: [
    ['#f07a6e', '#f2c46d', '#a8e6cf'],
    ['#a8e6cf', '#f07a6e', '#f4efe6'],
    ['#f2c46d', '#a8e6cf', '#f07a6e'],
  ][i % 3]!,
}));
---

<section id="observatory" class="observatory container-content" aria-labelledby="observatory-title">
  <SectionHeading
    id="observatory-title"
    kicker="01"
    title={t('observatory.title')}
    lead={t('observatory.lead')}
    leadPersonal={t('observatory.lead.personal')}
  />

  <!-- ============ Professional scene ============ -->
  <div class="field field-pro">
    <div
      class="scene reveal"
      data-observatory-scene
      data-hash-prefix="observatory"
      role="group"
      aria-label={t('observatory.title')}
    >
      <div class="deep-field" aria-hidden="true">
        {
          Array.from({ length: 56 }, (_, i) => (
            <i
              style={`--x:${(unitHash(`bg:${i}:x`) * 100).toFixed(2)}%;--y:${(unitHash(`bg:${i}:y`) * 100).toFixed(2)}%;--s:${(0.4 + unitHash(`bg:${i}:s`) * 1.2).toFixed(2)};--d:${(unitHash(`bg:${i}:d`) * 6).toFixed(2)}s`}
            />
          ))
        }
      </div>
      {
        nebulae.map((n) => {
          const list = byNebula.get(n.id) ?? [];
          const stars = list.reduce((acc, p) => acc + p.data.highlights.length, 0);
          return (
            <button
              type="button"
              class="nebula"
              data-nebula={n.id}
              data-x={n.scene.x}
              data-y={n.scene.y}
              data-zoom={(1.6 + (1.3 - n.scene.scale) * 0.6).toFixed(2)}
              aria-pressed="false"
              style={`--nx:${n.scene.x}%;--ny:${n.scene.y}%;--ns:${n.scene.scale};--c1:${n.palette[0]};--c2:${n.palette[1]};--c3:${n.palette[2] ?? n.palette[0]}`}
            >
              {nebulaImage(n.id) && (
                <Picture
                  src={nebulaImage(n.id)!}
                  formats={['avif', 'webp']}
                  widths={[320, 640]}
                  sizes="(max-width: 900px) 40vw, 18rem"
                  alt=""
                  class="photo"
                  loading="lazy"
                />
              )}
              <span class="gas gas-a" aria-hidden="true" />
              <span class="gas gas-b" aria-hidden="true" />
              <span class="gas gas-c" aria-hidden="true" />
              <span class="dust" aria-hidden="true">
                {dust(n.id, 26).map((d) => (
                  <i
                    style={`--x:${d.x.toFixed(2)}%;--y:${d.y.toFixed(2)}%;--s:${d.s.toFixed(2)}`}
                  />
                ))}
              </span>
              <span class="nebula-label">
                <span class="nebula-name">{pick(n.labels, locale)}</span>
                <span class="nebula-meta mono">
                  {n.object.designation} · {list.length}{' '}
                  {list.length === 1 ? t('observatory.project') : t('observatory.projects')} ·{' '}
                  {stars} {t('observatory.stars')}
                </span>
              </span>
            </button>
          );
        })
      }
    </div>

    <p class="hint mono" data-observatory-hint>{t('observatory.select')} →</p>

    {
      nebulae.map((n) => {
        const list = byNebula.get(n.id) ?? [];
        return (
          <article class="panel" data-nebula-panel={n.id} hidden aria-live="polite">
            <header class="panel-head">
              <div>
                <p class="mono text-accent-3 text-xs uppercase tracking-[0.2em]">
                  {t('observatory.modelled')} {n.object.name} · {n.object.designation} ·{' '}
                  {n.object.constellation} ·{' '}
                  {n.object.distanceLy.toLocaleString(
                    locale === 'en' ? 'en-US' : locale === 'es' ? 'es-MX' : 'pt-BR',
                  )}{' '}
                  {t('observatory.distance')}
                </p>
                <h3 class="mt-2">{pick(n.labels, locale)}</h3>
                <p class="text-ink-muted mt-2 max-w-2xl">{pick(n.descriptions, locale)}</p>
                {creditById.get(n.id) && (
                  <p class="mono credit">
                    {t('observatory.imageCredit')}: {creditById.get(n.id)!.telescope}
                    {creditById.get(n.id)!.instrument
                      ? ` ${creditById.get(n.id)!.instrument}`
                      : ''}{' '}
                    ·{' '}
                    <a
                      href={creditById.get(n.id)!.source}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {creditById.get(n.id)!.credit}
                    </a>{' '}
                    · {creditById.get(n.id)!.license}
                  </p>
                )}
              </div>
              <button type="button" class="btn btn-ghost" data-nebula-back>
                ← {t('observatory.back')}
              </button>
            </header>

            {list.length === 0 && <p class="text-ink-muted mt-6">{t('observatory.empty')}</p>}

            <ul class="stars-list">
              {list.map((p) => (
                <li class="star-card glow lift">
                  <div class="star-card-head">
                    <h4>{p.data.title}</h4>
                    <p class="mono text-xs text-ink-muted">
                      {formatMonth(p.data.period.start, locale, '')} →{' '}
                      {formatMonth(p.data.period.end, locale, t('observatory.present'))}
                    </p>
                  </div>
                  <p class="text-ink-muted mt-2">{p.data.summary}</p>
                  <dl class="facts">
                    <div>
                      <dt>{t('observatory.role')}</dt>
                      <dd>{p.data.role}</dd>
                    </div>
                    <div>
                      <dt>{t('observatory.stack')}</dt>
                      <dd>
                        <ul class="chips">
                          {p.data.stack.map((s) => (
                            <li translate="no">{s}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                  <p class="mono text-xs text-accent-3 mt-4 uppercase tracking-[0.18em]">
                    {t('observatory.highlights')}
                  </p>
                  <ul class="highlights">
                    {p.data.highlights.map((h) => (
                      <li>
                        <span class="hstar" aria-hidden="true" />
                        {h}
                      </li>
                    ))}
                  </ul>
                  {p.data.visibility === 'public' && p.data.repo && repoStats.get(p.data.repo) && (
                    <ul class="repo-stats mono" aria-label={t('observatory.repo')}>
                      <li>
                        ★ {formatCount(repoStats.get(p.data.repo)!.stars, locale)} {t('repo.stars')}
                      </li>
                      <li>
                        ⑂ {formatCount(repoStats.get(p.data.repo)!.forks, locale)} {t('repo.forks')}
                      </li>
                      {repoStats.get(p.data.repo)!.traffic && (
                        <li>
                          ◉ {formatCount(repoStats.get(p.data.repo)!.traffic!.views, locale)}{' '}
                          {t('repo.views')}
                        </li>
                      )}
                      {repoStats.get(p.data.repo)!.language && (
                        <li>{repoStats.get(p.data.repo)!.language}</li>
                      )}
                      <li>
                        {t('repo.updated')}{' '}
                        {formatMonth(repoStats.get(p.data.repo)!.pushedAt.slice(0, 10), locale, '')}
                      </li>
                    </ul>
                  )}
                  <div class="star-card-foot">
                    {p.data.visibility !== 'public' ? (
                      <p class="mono text-xs text-ink-muted">
                        {t(
                          p.data.visibility === 'course'
                            ? 'observatory.course'
                            : 'observatory.confidential',
                        )}
                      </p>
                    ) : (
                      p.data.repo && (
                        <a
                          class="mono text-sm"
                          href={`https://github.com/${p.data.repo}`}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {t('observatory.repo')}: {p.data.repo} ↗
                        </a>
                      )
                    )}
                    <a
                      class="btn btn-ghost btn-sm"
                      href={localePath(locale, `/projects/${p.data.key}`)}
                    >
                      {t('observatory.details')}
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <!-- ============ Personal scene ============ -->
  <div class="field field-personal">
    <div
      class="scene reveal"
      data-observatory-scene
      data-hash-prefix="universe"
      role="group"
      aria-label={t('personal.title')}
    >
      <Picture
        src={personalBg}
        formats={['avif', 'webp']}
        widths={[700, 1400]}
        sizes="(max-width: 900px) 100vw, 72rem"
        alt=""
        class="scene-bg"
        loading="lazy"
      />
      <div class="deep-field" aria-hidden="true">
        {
          Array.from({ length: 56 }, (_, i) => (
            <i
              style={`--x:${(unitHash(`pbg:${i}:x`) * 100).toFixed(2)}%;--y:${(unitHash(`pbg:${i}:y`) * 100).toFixed(2)}%;--s:${(0.4 + unitHash(`pbg:${i}:s`) * 1.2).toFixed(2)};--d:${(unitHash(`pbg:${i}:d`) * 6).toFixed(2)}s`}
            />
          ))
        }
      </div>
      {
        personalScene.map((c) => (
          <button
            type="button"
            class="nebula"
            data-nebula={c.id}
            data-x={c.scene.x}
            data-y={c.scene.y}
            data-zoom="1.8"
            aria-pressed="false"
            style={`--nx:${c.scene.x}%;--ny:${c.scene.y}%;--ns:${c.scene.scale};--c1:${c.palette[0]};--c2:${c.palette[1]};--c3:${c.palette[2]}`}
          >
            {c.image && nebulaImage(c.image) && (
              <Picture
                src={nebulaImage(c.image)!}
                formats={['avif', 'webp']}
                widths={[320, 640]}
                sizes="(max-width: 900px) 40vw, 18rem"
                alt=""
                class="photo"
                loading="lazy"
              />
            )}
            <span class="gas gas-a" aria-hidden="true" />
            <span class="gas gas-b" aria-hidden="true" />
            <span class="gas gas-c" aria-hidden="true" />
            <span class="dust" aria-hidden="true">
              {dust(`p:${c.id}`, 22).map((d) => (
                <i style={`--x:${d.x.toFixed(2)}%;--y:${d.y.toFixed(2)}%;--s:${d.s.toFixed(2)}`} />
              ))}
            </span>
            <span class="nebula-label">
              <span class="nebula-name">{c.label}</span>
              <span class="nebula-meta mono">{c.object}</span>
            </span>
          </button>
        ))
      }
    </div>

    <p class="hint mono" data-observatory-hint>{t('observatory.select')} →</p>

    {
      personalScene.map((c) => (
        <article class="panel" data-nebula-panel={c.id} hidden aria-live="polite">
          <header class="panel-head">
            <div>
              <p class="mono text-accent-3 text-xs uppercase tracking-[0.2em]">{c.object}</p>
              <h3 class="mt-2">{c.label}</h3>
              <p class="text-ink-muted mt-2 max-w-2xl">{c.blurb}</p>
              {c.image && creditById.get(c.image) && (
                <p class="mono credit">
                  {t('observatory.imageCredit')}: {creditById.get(c.image)!.telescope}
                  {creditById.get(c.image)!.instrument
                    ? ` ${creditById.get(c.image)!.instrument}`
                    : ''}{' '}
                  ·{' '}
                  <a
                    href={creditById.get(c.image)!.source}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {creditById.get(c.image)!.credit}
                  </a>
                </p>
              )}
            </div>
            <button type="button" class="btn btn-ghost" data-nebula-back>
              ← {t('observatory.back')}
            </button>
          </header>
          <ul class="highlights mt-6">
            {c.items.map((h) => (
              <li>
                <span class="hstar" aria-hidden="true" />
                {h}
              </li>
            ))}
          </ul>
        </article>
      ))
    }

    <div class="personal-extra">
      <div class="soft glow lift">
        <h3 class="text-lg">{t('personal.soft')}</h3>
        <ul class="soft-list">
          {
            personal.softSkills.map((s) => (
              <li>
                <strong>{s.name}</strong>
                <span class="text-ink-muted">{s.evidence}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="facts-box glow lift">
        <h3 class="text-lg">{t('personal.facts')}</h3>
        <ul class="fun">
          {personal.funFacts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      {
        /* Hide the heatmap when the anonymous 90-day fallback has too little data to be meaningful. */
        contributions && contributions.source === 'graphql' && (
          <Contributions locale={locale} data={contributions} />
        )
      }
    </div>
  </div>
</section>

<style>
  .observatory {
    padding-block: 6rem 4rem;
    scroll-margin-top: var(--nav-h);
  }
  .field {
    margin-top: 2.5rem;
  }
  .field-personal {
    display: none;
  }
  :global([data-mode='personal']) .field-pro {
    display: none;
  }
  :global([data-mode='personal']) .field-personal {
    display: block;
    animation: rise var(--dur-slow) var(--ease-out);
  }

  .scene {
    --fx: 50;
    --fy: 50;
    --fs: 1;
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 24rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 70% 20%, var(--nebula-c), transparent 60%),
      radial-gradient(70% 60% at 20% 80%, var(--nebula-b), transparent 60%),
      linear-gradient(200deg, var(--bg-1), var(--bg-0));
    isolation: isolate;
    contain: layout paint;
    transition: background var(--dur-universe) var(--ease-out);
  }
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 100% at 50% 50%,
      transparent 55%,
      color-mix(in oklab, var(--bg-0) 70%, transparent)
    );
    pointer-events: none;
  }
  .scene-bg,
  .scene-bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  :global([data-theme='atlas']) .scene-bg :global(img) {
    opacity: 0.1;
    mix-blend-mode: multiply;
  }
  .deep-field {
    position: absolute;
    inset: 0;
    transform-origin: calc(var(--fx) * 1%) calc(var(--fy) * 1%);
    transition: transform var(--dur-universe) var(--ease-out);
  }
  .is-focused .deep-field {
    transform: scale(calc(var(--fs) * 0.6 + 0.6));
  }
  .deep-field i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--s) * 1.4px);
    height: calc(var(--s) * 1.4px);
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.55;
    animation: twinkle 4s ease-in-out infinite;
    animation-delay: var(--d);
  }

  .nebula {
    position: absolute;
    left: var(--nx);
    top: var(--ny);
    width: calc(var(--ns) * clamp(9rem, 22vw, 16rem));
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    cursor: pointer;
    transition:
      transform var(--dur-universe) var(--ease-out),
      opacity var(--dur-slow) var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
    will-change: transform;
  }
  .nebula:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .is-focused .nebula.is-dimmed {
    opacity: 0.18;
    filter: blur(2px) saturate(0.6);
    pointer-events: none;
  }
  .is-focused .nebula.is-active {
    transform: translate(-50%, -50%) scale(1.35);
    z-index: 2;
  }
  .photo,
  .photo :global(img) {
    position: absolute;
    inset: 4%;
    width: 92%;
    height: 92%;
    border-radius: 50%;
    object-fit: cover;
    /* Soft circular vignette so the photograph blends into the procedural gas */
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 55%, transparent 72%);
    mask-image: radial-gradient(circle at 50% 50%, #000 55%, transparent 72%);
    opacity: 0.95;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .nebula:hover .photo :global(img),
  .nebula.is-active .photo :global(img) {
    transform: scale(1.04);
  }
  :global([data-theme='atlas']) .photo :global(img) {
    filter: saturate(0.75) contrast(0.95);
    opacity: 0.85;
  }
  .credit {
    margin-top: 0.6rem;
    font-size: 0.68rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }
  .credit a {
    color: var(--ink-muted);
  }
  .gas {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    filter: blur(14px);
    mix-blend-mode: screen;
    opacity: 0.6;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .gas-a {
    background: radial-gradient(circle at 45% 45%, var(--c1) 0%, transparent 62%);
    animation: drift 40s ease-in-out infinite alternate;
  }
  .gas-b {
    inset: 8%;
    background: radial-gradient(circle at 60% 40%, var(--c2) 0%, transparent 60%);
    animation: drift 55s ease-in-out infinite alternate-reverse;
    transform: rotate(35deg) scale(1.05, 0.8);
  }
  .gas-c {
    inset: 18%;
    background: radial-gradient(circle at 50% 55%, var(--c3) 0%, transparent 58%);
    opacity: 0.7;
    animation: drift 70s ease-in-out infinite alternate;
  }
  :global([data-theme='atlas']) .gas {
    mix-blend-mode: multiply;
    opacity: 0.55;
  }
  .nebula:hover .gas,
  .nebula.is-active .gas {
    transform: scale(1.08);
  }
  .dust {
    position: absolute;
    inset: 0;
  }
  .dust i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--s) * 1.5px);
    height: calc(var(--s) * 1.5px);
    border-radius: 50%;
    background: #fff7e6;
    box-shadow: 0 0 6px var(--c1);
    opacity: 0.9;
  }
  :global([data-theme='atlas']) .dust i {
    background: var(--ink);
    box-shadow: none;
    opacity: 0.7;
  }
  .nebula-label {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, 0.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    white-space: nowrap;
    pointer-events: none;
  }
  .nebula-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--ink);
    text-shadow: 0 2px 12px var(--bg-0);
  }
  .nebula-meta {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .hint {
    margin-top: 0.8rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  .panel {
    margin-top: 1.5rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--bg-1) 70%, transparent);
    animation: rise var(--dur-slow) var(--ease-out);
