---
import Base from '@/layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Observatory from './Observatory.astro';
import Trajectory from './Trajectory.astro';
import Constellation from './Constellation.astro';
import Contact from './Contact.astro';
import LogLatest from './LogLatest.astro';
import Footer from './Footer.astro';
import Ticker from './Ticker.astro';
import { clientStrings, type Locale, useTranslations } from '@/i18n/ui';
import { safeJson } from '@/lib/json';
import {
  getCertifications,
  getNebulae,
  getPersonal,
  getProfile,
  getProjects,
  getSkills,
  getTrajectory,
} from '@/lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const [profile, trajectory, projects, nebulae, skills, certifications, personal] =
  await Promise.all([
    getProfile(locale),
    getTrajectory(locale),
    getProjects(locale),
    getNebulae(),
    getSkills(),
    getCertifications(),
    getPersonal(locale),
  ]);

const t = useTranslations(locale);
const fmt = new Intl.NumberFormat(
  locale === 'pt-br' ? 'pt-BR' : locale === 'es' ? 'es-MX' : 'en-US',
);
const tickerSky = nebulae.map(
  (n) =>
    `${n.object.designation} · ${n.object.name} · ${n.object.constellation} · ${fmt.format(n.object.distanceLy)} ${t('ticker.ly')}`,
);
const tickerStack = skills.flatMap((g) => g.items.map((i) => i.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.nickname,
  url: 'https://rubo6.dev/',
  image: 'https://rubo6.dev/og/default.png',
  jobTitle: 'Data Engineer / Analytics Engineer',
  worksFor: { '@type': 'Organization', name: 'Mercado Libre · Mercado Pago Point' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Instituto Tecnológico Autónomo de México (ITAM)' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Iberoamericana' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.location.city,
    addressCountry: 'MX',
  },
  email: `mailto:${profile.email}`,
  sameAs: profile.links.map((l) => l.url),
  knowsAbout: [
    'Data Engineering',
    'BigQuery',
    'SQL',
    'Python',
    'TypeScript',
    'Machine Learning',
    'Astronomy',
  ],
  knowsLanguage: ['es', 'en'],
};
---

<Base locale={locale} path="/">
  <script type="application/ld+json" set:html={safeJson(jsonLd)} slot="head" />
  <script
    type="application/json"
    id="client-strings"
    set:html={safeJson(clientStrings(locale))}
    slot="head"
  />
  <Nav locale={locale} path="/" />
  <main id="main">
    <Hero locale={locale} profile={profile} />
    <Ticker items={tickerSky} label={t('ticker.sky')} direction="left" />
    <Observatory locale={locale} nebulae={nebulae} projects={projects} personal={personal} />
    <Trajectory locale={locale} entries={trajectory} />
    <Constellation locale={locale} groups={skills} certifications={certifications} />
    <LogLatest locale={locale} />
    <Contact locale={locale} profile={profile} />
  </main>
  <Ticker items={tickerStack} label={t('ticker.stack')} direction="right" pace={3.5} />
  <Footer locale={locale} />
</Base>
